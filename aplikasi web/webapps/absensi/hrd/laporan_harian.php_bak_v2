                    </select>
                </div>
                <div>
                    <button onclick="loadTable()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded transition shadow-lg flex justify-center items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v3a1 1 0 01-.293.707L12 11.414V15a1 1 0 01-.293.707l-2 2A1 1 0 018 17v-5.586L3.293 6.707A1 1 0 013 6V3z" clip-rule="evenodd" /></svg>
                        Tampilkan
                    </button>
                </div>
            </div>
        </div>

        <div class="bg-gray-800 p-4 rounded-lg shadow-lg border border-gray-700">
            <table id="tabelAbsen" class="display responsive nowrap w-full text-sm" style="width:100%">
                <thead>
                    <tr class="text-left text-gray-400 border-b border-gray-600">
                        <th class="py-3">Nama Pegawai</th>
                        <th class="py-3 text-center">Shift</th>
                        <th class="py-3">Tanggal</th>
                        <th class="py-3 text-center">Masuk</th>
                        <th class="py-3 text-center">Pulang</th>
                        <th class="py-3 text-center">Status</th>
                        <th class="py-3 text-center">Telat</th>
                        <th class="py-3 text-center">Durasi</th>
                        <th class="py-3 text-center">Foto</th>
                        <th class="py-3">Catatan</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.4.1/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.print.min.js"></script>

    <script>
        let table;

        $(document).ready(function() {
            // 1. Load Dropdown Departemen
            $.get('api_laporan.php?act=get_dep', function(res) {
                try {
                    const data = JSON.parse(res);
                    data.forEach(d => {
                        $('#dep').append(`<option value="${d.dep_id}">${d.nama}</option>`);
                    });
                } catch(e) {}
            });

            // 2. Inisialisasi DataTable
            table = $('#tabelAbsen').DataTable({
                responsive: true,
                dom: 'Bfrtip',
                buttons: [
                    { extend: 'excel', className: 'bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded text-xs mr-1 border-none font-bold' },
                    { extend: 'pdf', className: 'bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-xs mr-1 border-none font-bold' },
                    { extend: 'print', className: 'bg-gray-600 hover:bg-gray-700 text-white px-3 py-1 rounded text-xs mr-1 border-none font-bold' }
                ],
                language: {
                    search: "Cari:",
                    lengthMenu: "Tampil _MENU_ baris",
                    info: "Hal _PAGE_ dari _PAGES_",
                    paginate: { first: "Awal", last: "Akhir", next: "Maju", previous: "Mundur" },
                    emptyTable: "Tidak ada data absensi pada periode ini"
                },
                order: [[2, 'desc'], [0, 'asc']], // Urutkan berdasarkan Tanggal (Terbaru), lalu Nama (A-Z)
                
                // --- PENINGKATAN VISUAL & URUTAN KOLOM BARU ---
                columns: [
                    // 1. Nama Pegawai (Gabung Nama, NIK, Dep)
                    { data: 'nama', render: function(data, type, row) {
                        return `<div>
                                    <div class="font-bold text-white text-sm">${row.nama}</div>
                                    <div class="text-xs text-blue-400 font-mono">${row.nik}</div>
                                    <div class="text-[10px] text-gray-500 uppercase mt-0.5">${row.dep}</div>
                                </div>`;
                    }},
                    
                    // 2. Shift (Badge)
                    { data: 'shift', className: "text-center", render: function(data) {
                        return `<span class="bg-gray-700 text-gray-300 px-2 py-1 rounded text-[10px] border border-gray-600 font-bold uppercase tracking-wider">${data}</span>`;
                    }},

                    // 3. Tanggal (Dari Jam Datang)
                    { data: 'jam_datang', render: function(data, type, row) {
                        // Format: "Senin, 01 Jan 2026"
                        let date = new Date(data);
                        let options = { weekday: 'long', day: 'numeric', month: 'short', year: 'numeric' };
                        return `<div class="text-sm text-gray-200 font-medium">${date.toLocaleDateString('id-ID', options)}</div>`;
                    }},

                    // 4. Jam Masuk
                    { data: 'display_masuk', className: "text-center", render: function(data) {
                        return `<span class="text-green-400 font-mono font-bold text-sm bg-green-900/30 px-2 py-1 rounded border border-green-900/50">${data}</span>`;
                    }},

                    // 5. Jam Pulang
                    { data: 'display_pulang', className: "text-center", render: function(data) {
                        if(data === '-' || !data) return '<span class="text-yellow-500 text-xs animate-pulse">--:--</span>';
                        return `<span class="text-yellow-400 font-mono font-bold text-sm bg-yellow-900/30 px-2 py-1 rounded border border-yellow-900/50">${data}</span>`;
                    }},
                    
                    // 6. Status (Traffic Light)
                    { data: 'status', className: "text-center", render: function(data) {
                        let badgeClass = 'bg-green-900 text-green-200 border-green-700'; // Default Hijau
                        let icon = '✅';

                        if(data.includes('Terlambat')) {
                            badgeClass = 'bg-red-900 text-red-200 border-red-700'; // Merah jika telat
                            icon = '⚠️';
                        } else if(data.includes('PSW')) {
                            badgeClass = 'bg-yellow-900 text-yellow-200 border-yellow-700'; // Kuning jika PSW
                            icon = '🛑';
                        }

                        return `<span class="${badgeClass} px-2 py-1 rounded text-[10px] font-bold border flex items-center justify-center gap-1 w-fit mx-auto whitespace-nowrap shadow-sm">
                                    ${icon} ${data}
                                </span>`;
                    }},

                    // 7. Telat
                    { data: 'telat', className: "text-center", render: function(data) {
                        if(!data || data === '') return '<span class="text-gray-600">-</span>';
                        return `<span class="text-red-400 font-bold font-mono text-xs">${data}</span>`;
                    }},

                    // 8. Durasi
                    { data: 'durasi', className: "text-center", render: function(data) {
                        if(!data) return '-';
                        let jam = parseInt(data.split(':')[0]);
                        // Jika kurang dari 7 jam, warnai kuning/oranye
                        let color = (jam < 7) ? 'text-orange-400' : 'text-gray-300';
                        return `<span class="${color} font-mono font-bold text-xs">${data}</span>`;
                    }},

                    // 9. Foto
                    { data: 'photo', className: "text-center", render: function(data, type, row) {
                        let imgPath = "../../" + data;
                        return `<button onclick="lihatFoto('${imgPath}', '${row.nama}')" class="text-blue-400 hover:text-white transition bg-gray-800 p-1.5 rounded-lg border border-gray-600 hover:border-blue-400 shadow">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                </button>`;
                    }},
                    
                    // 10. Catatan
                    { data: 'catatan', render: function(data) {
                        return `<span class="text-xs text-gray-500 italic truncate max-w-[120px] block" title="${data}">${data || '-'}</span>`;
                    }}
                ]
            });

            // Filter Dropdown Change Event
            $('#filter_masalah').on('change', function() {
                let val = $(this).val();
                // Filter pada kolom Status (Index 5 sekarang)
                table.column(5).search(val).draw();
            });

            loadTable();
        });

        function loadTable() {
            const tgl1 = $('#tgl1').val();
            const tgl2 = $('#tgl2').val();
            const dep = $('#dep').val();
            
            $('#filter_masalah').val(''); 
            table.search('').columns().search('').draw();

            table.ajax.url(`api_laporan.php?act=get_data&tgl1=${tgl1}&tgl2=${tgl2}&dep=${dep}`).load();
        }

        function lihatFoto(url, nama) {
            Swal.fire({
                title: nama,
                imageUrl: url,
                imageAlt: 'Bukti Absen',
                imageHeight: 400,
                background: '#1f2937',
                color: '#fff',
                confirmButtonColor: '#2563eb'
            });
        }
    </script>
</body>
</html>