<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="rptSBAR" language="java" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="no_rawat" class="java.lang.String"/>
	<parameter name="tanggal" class="java.lang.String"/>
	<parameter name="jam" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT s.no_rawat, s.tanggal, s.jam, s.situation, s.background, s.assessment, s.recommendation, s.tbak, s.waktu_konfirmasi, s.nip_pemberi, s.nip_penerima, s.nip_perekam, COALESCE(p.nama,'') AS nm_pemberi, COALESCE(d.nm_dokter,'') AS nm_penerima, COALESCE(u.nama,s.nip_perekam,'') AS nm_perekam, COALESCE(r.no_rkm_medis,'') AS no_rm, COALESCE(ps.nm_pasien,'') AS nm_pasien, COALESCE(r.stts_daftar,'') AS jenis_rawat, COALESCE(pol.nm_poli,'') AS nm_poli FROM rekammedis_sbar s LEFT JOIN petugas p ON s.nip_pemberi=p.nip LEFT JOIN dokter d ON s.nip_penerima=d.kd_dokter LEFT JOIN petugas u ON s.nip_perekam=u.nip LEFT JOIN reg_periksa r ON s.no_rawat=r.no_rawat LEFT JOIN pasien ps ON r.no_rkm_medis=ps.no_rkm_medis LEFT JOIN poliklinik pol ON r.kd_poli=pol.kd_poli WHERE s.no_rawat=$P{no_rawat} AND s.tanggal=$P{tanggal} AND s.jam=$P{jam} LIMIT 1]]>
	</queryString>
	<field name="no_rawat" class="java.lang.String"/>
	<field name="tanggal" class="java.lang.String"/>
	<field name="jam" class="java.lang.String"/>
	<field name="situation" class="java.lang.String"/>
	<field name="background" class="java.lang.String"/>
	<field name="assessment" class="java.lang.String"/>
	<field name="recommendation" class="java.lang.String"/>
	<field name="tbak" class="java.lang.String"/>
	<field name="waktu_konfirmasi" class="java.lang.String"/>
	<field name="nip_pemberi" class="java.lang.String"/>
	<field name="nip_penerima" class="java.lang.String"/>
	<field name="nip_perekam" class="java.lang.String"/>
	<field name="nm_pemberi" class="java.lang.String"/>
	<field name="nm_penerima" class="java.lang.String"/>
	<field name="nm_perekam" class="java.lang.String"/>
	<field name="no_rm" class="java.lang.String"/>
	<field name="nm_pasien" class="java.lang.String"/>
	<field name="jenis_rawat" class="java.lang.String"/>
	<field name="nm_poli" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="95" splitType="Stretch">
			<image scaleImage="FillFrame" onErrorType="Blank">
				<reportElement x="0" y="2" width="50" height="50"/>
				<imageExpression class="java.io.InputStream"><![CDATA[$P{logo}]]></imageExpression>
			</image>
			<textField>
				<reportElement x="55" y="2" width="500" height="16"/>
				<textElement textAlignment="Center" lineSpacing="Single">
					<font fontName="Tahoma" size="12" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$P{namars}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="55" y="18" width="500" height="12"/>
				<textElement textAlignment="Center" lineSpacing="Single">
					<font fontName="Tahoma" size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$P{alamatrs}+" - "+$P{kotars}+", "+$P{propinsirs}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="55" y="30" width="500" height="12"/>
				<textElement textAlignment="Center" lineSpacing="Single">
					<font fontName="Tahoma" size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Telp: "+$P{kontakrs}+"  Email: "+$P{emailrs}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="54" width="555" height="1"/>
				<graphicElement><pen lineWidth="2.0" lineStyle="Double"/></graphicElement>
			</line>
			<staticText>
				<reportElement x="0" y="58" width="555" height="18"/>
				<textElement textAlignment="Center" lineSpacing="Single">
					<font fontName="Tahoma" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[CATATAN KOMUNIKASI SBAR]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="76" width="555" height="12"/>
				<textElement textAlignment="Center" lineSpacing="Single">
					<font fontName="Tahoma" size="9" isItalic="true"/>
				</textElement>
				<text><![CDATA[(Situation - Background - Assessment - Recommendation)]]></text>
			</staticText>
			<line>
				<reportElement x="0" y="91" width="555" height="1"/>
				<graphicElement><pen lineWidth="0.5"/></graphicElement>
			</line>
		</band>
	</title>
	<detail>
