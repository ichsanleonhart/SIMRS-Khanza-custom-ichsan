				<textElement lineSpacing="Single"><font fontName="Tahoma" size="9"/></textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{tanggal}+" / "+$F{jam}]]></textFieldExpression>
			</textField>
			<line>
