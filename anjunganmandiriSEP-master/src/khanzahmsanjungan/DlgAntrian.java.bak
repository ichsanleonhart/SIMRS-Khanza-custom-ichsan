    public void autonomer(){
        Valid.autoNomer3("select ifnull(MAX(CONVERT(antripendaftaran_nomor.nomor,signed)),0) from antripendaftaran_nomor where LEFT(antripendaftaran_nomor.jam,10)=current_date()","",1,LabelNomor);
